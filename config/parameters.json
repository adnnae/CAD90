          "default": 2.0,
          "min": 0.1,
          "required": true,
          "applies_to": ["simple", "double", "triple"]
        },
        {
          "id": "gabarit",
          "label": "Gabarit (m)",
          "type": "float",
          "default": 2.0,
          "min": 0.1,
          "required": true,
          "applies_to": ["simple", "double", "triple"]
        },
        {
